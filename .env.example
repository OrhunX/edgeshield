# EdgeShield — örnek yapılandırma.
# Kopyala: cp .env.example .env   ·   sonra .env içindeki değerleri kendin belirle.
# .env dosyası .gitignore'da; asla depoya girmez.

# MQTT aracısı
EDGESHIELD_BROKER=localhost
EDGESHIELD_PORT=1883
EDGESHIELD_USER=edgeshield

# Sırlar — kendi değerlerini üret, buradakileri kullanma
EDGESHIELD_PASS=degistir-beni
EDGESHIELD_HMAC_KEY=degistir-beni-uzun-rastgele-bir-dizge

# Yollar (isteğe bağlı; verilmezse depo kökünün altına düşer)
# EDGESHIELD_HOME=/home/pi/edgeshield
# EDGESHIELD_DB=/home/pi/edgeshield/data/edgeshield.db
# EDGESHIELD_LOGS=/home/pi/edgeshield/logs
